---
import Default from '../layouts/Default.astro';
---
<Default>
  <section class="bio">
    <p>awesame is the music project of Atlanta DJ and producer Sam Lawrence: grooves with depth, made to celebrate the good things about life on earth. Behind the decks since 2014, host of the Contrast party for two years, and founder of the label UUeird.</p>
  </section>

  <!-- Mailchimp audience "awesame" (us1, id 3b610fb9b6). Posts to Mailchimp, which handles confirmation. -->
  <form class="signup" action="https://uueird.us1.list-manage.com/subscribe/post?u=75f15b47333ffdb34d98a3e2e&amp;id=3b610fb9b6" method="post" target="_blank">
    <h2 class="signup-heading">Get new music and show dates in your inbox</h2>
    <div class="signup-row">
      <label for="signup-email" class="visually-hidden">Email address</label>
      <input type="email" name="EMAIL" id="signup-email" placeholder="you@example.com" autocomplete="email" required>
      <button type="submit">Sign up</button>
    </div>
    <!-- Honeypot: bots fill this in, people never see it -->
    <div class="signup-honeypot" aria-hidden="true">
      <input type="text" name="b_75f15b47333ffdb34d98a3e2e_3b610fb9b6" tabindex="-1" value="">
    </div>
    <p class="signup-note">A few emails a year. Unsubscribe any time.</p>
  </form>
</Default>
