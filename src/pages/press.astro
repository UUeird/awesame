---
import Default from '../layouts/Default.astro';
---
<Default title="Press Kit" description="Press kit for awesame — bio, photos, music, and contact info for booking and media inquiries.">
  <section class="page-section">
    <h1 class="page-title">Press Kit</h1>

    <div class="press-block">
      <h2>Bio</h2>
      <p>awesame makes music to celebrate the good things about life on earth. It's the project of Sam Lawrence, an Atlanta DJ and producer who hosted the Contrast party for two years and founded the label UUeird.</p>
    </div>

    <div class="press-block">
      <h2>Photos</h2>
      <p>High-resolution photos available on request.</p>
    </div>

    <div class="press-columns">
      <div class="press-block">
        <h2>Music</h2>
        <ul>
          <li><a href="https://soundcloud.com/awesame">SoundCloud</a></li>
          <li><a href="https://awesame.bandcamp.com/">Bandcamp</a></li>
        </ul>
      </div>

      <div class="press-block">
        <h2>Socials</h2>
        <ul>
          <li><a href="https://x.com/awesame">X</a></li>
          <li><a href="https://www.instagram.com/awesa.me">Instagram</a></li>
        </ul>
      </div>
    </div>

    <div class="press-block">
      <h2>Contact</h2>
      <p><a href="mailto:sam@uueird.com">sam@uueird.com</a></p>
    </div>
  </section>
</Default>
